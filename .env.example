# Porta da API
PORT=3001

# Chave mestra do cofre de certificados (32 bytes em base64). Gere com: npm run gen-key
# Guarde fora do servidor (gerenciador de segredos). Perdê-la torna os certificados irrecuperáveis.
OFFICE_LA_MASTER_KEY=

# Segredo de assinatura das sessões de login (qualquer string longa e aleatória)
SESSION_SECRET=

# Primeiro administrador, criado apenas se o banco estiver vazio
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Chave da API da Anthropic, usada na extração de dados das petições
ANTHROPIC_API_KEY=

# Webhook que recebe os eventos da fila (ex.: cenário do Make que envia WhatsApp)
NOTIFY_WEBHOOK_URL=

# 1 = habilita o adaptador "Simulação" (gera números fictícios; nunca usar em produção)
SIMULACAO=0
